{
  "name": "perfumes",
  "version": "0.2.0",
  "private": true,
  "description": "Perfumes — standalone wholesale trading platform for fine fragrance",
  "main": "server/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings server/index.js",
    "seed": "node --no-warnings server/seed.js",
    "import": "node src/index.js",
    "gen:samples": "node --no-warnings scripts/generate-samples.js",
    "gen:templates": "node --no-warnings scripts/generate-client-templates.js",
    "check:ai": "node --no-warnings scripts/check-ai.js",
    "check:aws": "node --check deploy/aws/lib.js && node --check deploy/aws/deploy.js && node --check deploy/aws/update.js && node --check deploy/aws/migrate.js && node --check deploy/aws/env.js && node --check deploy/aws/exec.js",
    "aws:deploy": "node deploy/aws/deploy.js",
    "aws:update": "node deploy/aws/update.js",
    "aws:migrate": "node deploy/aws/migrate.js",
    "aws:env": "node deploy/aws/env.js",
    "aws:exec": "node deploy/aws/exec.js",
    "backup:db": "node --no-warnings scripts/backup-db.js",
    "set:password": "node --no-warnings scripts/set-password.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
